{
  "name": "ts3pilot-suite",
  "version": "0.2.0",
  "private": true,
  "description": "TS3 Community Operations Suite — local-first TeamSpeak 3 management toolchain (CLI/Agent) with an optional WordPress control plane.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "check-env": "node scripts/check-env.mjs",
    "lint": "eslint apps/ts3-manager/src apps/ts3-manager/test --max-warnings 0",
    "typecheck": "npm run typecheck --workspace @ts3pilot/ts3-manager",
    "test": "npm run test --workspace @ts3pilot/ts3-manager && npm run test --workspace @ts3pilot/ts3pilot-wp",
    "build": "npm run build --workspace @ts3pilot/ts3-manager",
    "verify": "node scripts/verify.mjs",
    "release": "node scripts/release.mjs",
    "build-release": "node scripts/release.mjs",
    "cli": "node apps/ts3-manager/src/cli/index.ts",
    "package": "node scripts/package.mjs"
  }
}
